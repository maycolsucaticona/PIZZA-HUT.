    public static void crudBuscar(){
        System.out.println("--- Buscar producto ---");
        System.out.print("Ingrese el nombre exacto del producto: ");
        String buscar = escaner.nextLine();
        boolean enPizza = pizzas.contains(buscar);
        boolean enExtras = antojitos.contains(buscar);
        boolean enBebidas = bebidas.contains(buscar);
        boolean enMegapromos = megaPromos.contains(buscar);
        boolean enParami = paraMi.contains(buscar);
        if (enPizza || enExtras || enBebidas || enMegapromos || enParami){
            System.out.println("Resultado: '" + buscar + "' SÍ existe en el sistema.");
            if (enPizza) System.out.println("Tipo: Pizzas. Índice: " + pizzas.indexOf(buscar) + " | Precio: S/." + precioPizza.get(pizzas.indexOf(buscar)));
            if (enExtras) System.out.println("Tipo: Antojitos. Índice: " + antojitos.indexOf(buscar) + " | Precio: S/." + preciodeAntojitos.get(antojitos.indexOf(buscar)));
            if (enBebidas) System.out.println("Tipo: Bebidas. Índice: " + bebidas.indexOf(buscar) + " | Precio: S/." + precioBebidas.get(bebidas.indexOf(buscar)));
