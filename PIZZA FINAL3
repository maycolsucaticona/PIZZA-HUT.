    public static void pagarCarrito () {
        if (carritoPizza.isEmpty() && carritoAntojitos.isEmpty() && carritoBebidas.isEmpty() && carritoMegaPromos.isEmpty() && carritoParaMi.isEmpty()) {
            System.out.println("No hay productos en el carrito para procesar un pago.");
            return;
        }
        double totalAPagar = 0;
        for (double p : carritoPrecioPizza) totalAPagar += p;
        for (int idx : carritoAntojitos) totalAPagar += preciodeAntojitos.get(idx);
        for (int idx : carritoBebidas) totalAPagar += precioBebidas.get(idx);
        for (int idx : carritoMegaPromos) totalAPagar += precioMegaPromos.get(idx);
        for (int idx : carritoParaMi) totalAPagar += precioParMI.get(idx);;
        System.out.println("=================================");
        System.out.println(String.format(" TOTAL A PAGAR: S/.%.2f", totalAPagar));
        System.out.println("=================================");
        System.out.println("\n--- SELECCIONE MÉTODO DE PAGO ---");
        System.out.println("1. Efectivo");
        System.out.println("2. Tarjeta de Crédito/Débito");
        System.out.println("3. Cancelar Operación");
        System.out.print("Opción: ");
        int metodoPago = escaner.nextInt();
        escaner.nextLine();
        String tipoPago = "";
        String nombreArchivo ="";
        double montoEntregado = 0;
        double vuelto = 0;
        if (metodoPago == 1) {
            tipoPago = "EFECTIVO";
            nombreArchivo = "Boleta_Efectivo_PizzaHut.txt";
            System.out.print("¿Con cuánto va a pagar? Ingrese el monto S/. : ");
            montoEntregado = escaner.nextDouble();
            escaner.nextLine();
            if (montoEntregado < totalAPagar) {
                System.out.println("❌ ERROR: El monto ingresado es insuficiente. Operación cancelada automáticamente.");
                return;
            }
            vuelto = montoEntregado - totalAPagar;
            System.out.println(String.format("✔️ Monto aceptado. Su vuelto es: S/.%.2f", vuelto));

        } else if (metodoPago == 2) {
            tipoPago = "TARJETA";
            nombreArchivo = "Boleta_Tarjeta_PizzaHut.txt";
            validaPagoTarjeta(totalAPagar);
            if (!validaPagoTarjeta(totalAPagar)) {
                System.out.println("❌ TARJETA RECHAZADA: Fondos insuficientes o error de conexión. Operación cancelada.");
                return;
            }
            System.out.println("✔️ Pago con Tarjeta APROBADO.");

        } else {
            System.out.println("Operación cancelada por el usuario. Regresando a la tienda.");
            return;
        }
        seleccionarSede();
        try {
            FileWriter escritor = new FileWriter(nombreArchivo);
            escritor.write("         PIZZA HUT S.A.C.       \n");
            escritor.write("      RUC N° 20100534211        \n");
            escritor.write("AV. JAVIER PRADO ESTE NRO. 4200 \n");
            escritor.write("      LIMA - LIMA - SANTIAGO    \n");
            escritor.write("================================\n");
            escritor.write("     BOLETA DE VENTA ELECTRÓNICA\n");
            int numBoleta = (int)(Math.random() * 900000) + 100000;
            escritor.write("       NRO: B001-" + numBoleta + "\n");
            escritor.write("================================\n");
            escritor.write("FECHA EMISION: 19/06/2026 15:05\n");
            escritor.write("CLIENTE: " + usuarioActivo.toUpperCase() + "\n");
            escritor.write("MÉTODO DE PAGO: " + tipoPago + "\n");
            escritor.write("--------------------------------\n");
            escritor.write(String.format("%-22s %9s\n", "DESCRIPCIÓN", "TOTAL"));
            escritor.write("--------------------------------\n");
            for (int i = 0; i < carritoPizza.size(); i++) {
                String item = "1 " + carritoPizza.get(i);
                if (item.length() > 21) item = item.substring(0, 21);
                escritor.write(String.format("%-22s S/.%6.2f\n", item, carritoPrecioPizza.get(i)));
            }
            for (int idx : carritoAntojitos) {
                String item = "1 " + antojitos.get(idx);
                if (item.length() > 21) item = item.substring(0, 21);
                escritor.write(String.format("%-22s S/.%6.2f\n", item, preciodeAntojitos.get(idx)));
            }
            for (int idx : carritoBebidas) {
                String item = "1 " + bebidas.get(idx);
                if (item.length() > 21) item = item.substring(0, 21);
                escritor.write(String.format("%-22s S/.%6.2f\n", item, precioBebidas.get(idx)));
            }
            for (int idx : carritoMegaPromos) {
                String item = "1 " + megaPromos.get(idx);
