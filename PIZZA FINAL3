    public static double mostrarCarrito() {
        System.out.println("--- 🛒 TU CARRITO DE COMPRAS ---");
        double total = 0;
        if (carritoPizza.isEmpty() && carritoAntojitos.isEmpty() && carritoBebidas.isEmpty() && carritoMegaPromos.isEmpty() && carritoParaMi.isEmpty()) {
            System.out.println("[ El carrito está completamente vacío ]");
            return total;
        }
        for (int i = 0; i < carritoPizza.size(); i++) {
            System.out.println("- " + carritoPizza.get(i) + " -> S/." + carritoPrecioPizza.get(i));
            total += carritoPrecioPizza.get(i);
        }
        for (int idx : carritoAntojitos) {
            System.out.println("- " + antojitos.get(idx) + " (Antojito) -> S/." + preciodeAntojitos.get(idx));
            total += preciodeAntojitos.get(idx);
        }
        for (int idx : carritoBebidas) {
            System.out.println("- " + bebidas.get(idx) + " (Bebida) -> S/." + precioBebidas.get(idx));
            total += precioBebidas.get(idx);
        }
        for (int idx : carritoMegaPromos) {
            System.out.println("- " + megaPromos.get(idx) + " (Mega promos) -> S/." + precioMegaPromos.get(idx));
            total += precioMegaPromos.get(idx);
        }
        for (int idx : carritoParaMi) {
            System.out.println("- " + paraMi.get(idx) + " (Para mi) -> S/." + precioParMI.get(idx));
            total += precioParMI.get(idx);
        }
        System.out.println("---------------------------------");
        System.out.println("TOTAL ACUMULADO: S/." + total);
        return total;
    }
